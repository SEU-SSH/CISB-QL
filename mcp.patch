diff --git a/src/api-tools.ts b/src/api-tools.ts
new file mode 100644
index 0000000..9889646
--- /dev/null
+++ b/src/api-tools.ts
@@ -0,0 +1,100 @@
+import { readdir, readFile, realpath } from "node:fs/promises";
+import { isAbsolute, join, relative } from "node:path";
+import type { CompletionList } from "vscode-languageserver-protocol";
+
+export const CPP_ALL_VERSION = "7.0.0";
+
+export function queryArguments(query: unknown, offset: unknown = 0, allowEmpty = false) {
+    if (typeof query !== "string" || [...query].length > 128 || query.includes("\0") ||
+        (!allowEmpty && !query.trim())) {
+        throw new Error("query must be a literal string of at most 128 characters; search cannot be empty");
+    }
+    if (typeof offset !== "number" || !Number.isSafeInteger(offset) || offset < 0) {
+        throw new Error("offset must be a nonnegative safe integer");
+    }
+    return { query, offset };
+}
+
+function rank(name: string, query: string) {
+    if (name === query) return 0;
+    if (name.toLowerCase() === query.toLowerCase()) return 1;
+    return name.toLowerCase().includes(query.toLowerCase()) ? 2 : 3;
+}
+
+function compare(a: string, b: string) { return a < b ? -1 : a > b ? 1 : 0; }
+
+export function completePage(completions: CompletionList, query: unknown = "", offset: unknown = 0) {
+    const input = queryArguments(query, offset, true);
+    const items = completions.items.map((item, index) => ({ item, index, rank: rank(item.label, input.query) }))
+        .filter(item => item.rank < 3)
+        .sort((a, b) => a.rank - b.rank || compare(a.item.label, b.item.label) ||
+            compare(a.item.detail ?? "", b.item.detail ?? "") || a.index - b.index);
+    return {
+        ...completions,
+        query: input.query,
+        unfiltered_total: completions.items.length,
+        items: items.slice(input.offset, input.offset + 20).map(item => item.item),
+        pagination: { offset: input.offset, limit: 20, total: items.length, hasMore: input.offset + 20 < items.length },
+    };
+}
+
+function contained(root: string, path: string) {
+    const name = relative(root, path);
+    return name !== ".." && !name.startsWith("../") && !isAbsolute(name);
+}
+
+async function qllFiles(root: string, directory = root): Promise<string[]> {
+    const files: string[] = [];
+    for (const entry of await readdir(directory, { withFileTypes: true })) {
+        // Never follow pack symlinks, even when their target happens to be inside the pack.
+        if (entry.isSymbolicLink()) continue;
+        const path = await realpath(join(directory, entry.name));
+        if (!contained(root, path)) continue;
+        if (entry.isDirectory()) files.push(...await qllFiles(root, path));
+        else if (entry.isFile() && path.endsWith(".qll")) files.push(path);
+    }
+    return files.sort(compare);
+}
+
+export async function searchApi(rootPath: string | undefined, query: unknown, offset: unknown = 0) {
+    const input = queryArguments(query, offset);
+    if (!rootPath) throw new Error("CODEQL_CPP_ALL_ROOT is required for pinned cpp-all source search");
+    const root = await realpath(rootPath);
+    const files = await qllFiles(root);
+    if (!files.length) throw new Error("Pinned cpp-all source pack is unavailable or contains no .qll files");
+    const sources = new Map<string, string[]>();
+    const hits: { path: string; line: number; name: string; rank: number; declaration: boolean }[] = [];
+    for (const path of files) {
+        const source = await readFile(path, "utf8");
+        const name = relative(root, path);
+        sources.set(name, source.split(/\r?\n/));
+        // Lexical source lookup only: mask strings/comments without changing line positions.
+        const lines = source.replace(/\/\*[\s\S]*?\*\/|\/\/[^\n]*|"(?:\\.|[^"\\])*"/g,
+            value => value.replace(/[^\n]/g, " ")).split(/\r?\n/);
+        lines.forEach((line, index) => {
+            const declaration = line.match(/^\s*(?:(?:private|abstract|cached|override|final|transient|additional|extensible)\s+)*class\s+([A-Za-z_][A-Za-z_0-9]*)\b/) ??
+                line.match(/^\s*(?:(?:private|abstract|cached|override|final|transient|additional|extensible)\s+)*(?:predicate|int|float|string|boolean|date|[A-Z][A-Za-z_0-9]*(?:::[A-Za-z_][A-Za-z_0-9]*)*)\s+([A-Za-z_][A-Za-z_0-9]*)\s*\(/);
+            const names = [...new Set(line.match(/[A-Za-z_][A-Za-z_0-9]*/g) ?? [])]
+                .map(token => ({ name: token, rank: rank(token, input.query), declaration: token === declaration?.[1] }))
+                .filter(token => token.rank < 3)
+                .sort((a, b) => Number(b.declaration) - Number(a.declaration) || a.rank - b.rank || compare(a.name, b.name));
+            if (names.length) hits.push({ path: name, line: index + 1, ...names[0] });
+        });
+    }
+    hits.sort((a, b) => Number(b.declaration) - Number(a.declaration) || a.rank - b.rank ||
+        compare(a.path, b.path) || a.line - b.line);
+    const items = hits.slice(input.offset, input.offset + 10).map(hit => {
+        const lines = sources.get(hit.path)!;
+        const start = Math.max(0, hit.line - 6);
+        const end = Math.min(lines.length, start + 20);
+        const excerpt = lines.slice(start, end).join("\n");
+        const characters = [...excerpt];
+        return { path: hit.path, line: hit.line, name: hit.name,
+            match_kind: hit.declaration ? "declaration_hint" : "identifier",
+            source_start_line: start + 1, source: characters.slice(0, 2000).join(""),
+            truncated: { before: start > 0, after: end < lines.length, characters: characters.length > 2000 } };
+    });
+    return { pack: "codeql/cpp-all", version: CPP_ALL_VERSION, query: input.query,
+        position_encoding: "1-based source lines", lookup: "lexical_source_not_type_resolution", items,
+        pagination: { offset: input.offset, limit: 10, total: hits.length, hasMore: input.offset + 10 < hits.length } };
+}
