@@ -0,0 +1,111 @@
+import assert from "node:assert/strict";
+import { mkdtemp, mkdir, writeFile, rm, symlink } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import test from "node:test";
+import { completePage, queryArguments, searchApi } from "../dist/api-tools.js";
+
+async function fixture(t) {
+    const root = await mkdtemp(join(tmpdir(), "ql-api-test-"));
+    t.after(() => rm(root, { recursive: true, force: true }));
+    return root;
+}
+
+test("completion filters the full collection before paging and keeps native fields", () => {
+    const items = Array.from({ length: 40 }, (_, i) => ({ label: `A${i}` }));
+    const warning = "Note: getAQlClass is a debugging tool. It is not suitable for production QL code.";
+    items.push({ label: "getAQlClass", documentation: warning, textEdit: { newText: "getAQlClass()" } });
+    const page = completePage({ isIncomplete: true, items }, "getAQlClass");
+    assert.equal(page.items.length, 1);
+    assert.equal(page.items[0].documentation, warning);
+    assert.equal(page.items[0].textEdit.newText, "getAQlClass()");
+    assert.equal(page.pagination.total, 1);
+    assert.equal(page.unfiltered_total, 41);
+    assert.equal(page.isIncomplete, true);
+});
+
+test("completion ranking is exact, case-insensitive, then substring with stable pages", () => {
+    const items = [{ label: "AnEQExpr" }, { label: "eqexpr" }, { label: "EQExpr" }];
+    assert.deepEqual(completePage({ isIncomplete: false, items }, "EQExpr").items.map(x => x.label),
+        ["EQExpr", "eqexpr", "AnEQExpr"]);
+    const many = Array.from({ length: 45 }, (_, i) => ({ label: `Item${String(i).padStart(2, "0")}` }));
+    const first = completePage({ isIncomplete: false, items: many.reverse() });
+    const second = completePage({ isIncomplete: false, items: many }, "", 20);
+    assert.equal(first.items.length, 20);
+    assert.equal(second.items[0].label, "Item20");
+    assert.equal(second.pagination.total, 45);
+    assert.equal(second.pagination.hasMore, true);
+    assert.equal(completePage({ isIncomplete: false, items: many }, ".*").items.length, 0);
+});
+
+test("query and pagination validation is bounded and literal", () => {
+    for (const query of ["", " ", null, 3, "x".repeat(129), "a\0b"]) {
+        assert.throws(() => queryArguments(query));
+    }
+    for (const offset of [-1, true, 0.2, Infinity, Number.MAX_SAFE_INTEGER + 1]) {
+        assert.throws(() => queryArguments("Expr", offset));
+    }
+    assert.equal(queryArguments(".*").query, ".*");
+    assert.equal(queryArguments("", 0, true).query, "");
+});
+
+test("search ranks declarations, preserves positions and does not index comments or strings", async t => {
+    const root = await fixture(t);
+    await writeFile(join(root, "a.qll"), '// class FakeExpr {}\nstring x() { result = "class FakeExpr {}" }\n' +
+        "class AnotherEQExpr {}\nclass eqexpr {}\nclass EQExpr {}\n");
+    const result = await searchApi(root, "EQExpr");
+    assert.deepEqual(result.items.map(x => x.name), ["EQExpr", "eqexpr", "AnotherEQExpr"]);
+    assert.equal(result.items[0].line, 5);
+    assert.equal(result.items[0].path, "a.qll");
+    assert.equal(result.version, "7.0.0");
+    assert.equal((await searchApi(root, "FakeExpr")).items.length, 0);
+    assert.equal((await searchApi(root, ".*")).items.length, 0);
+    assert.equal((await searchApi(root, "UnfindableApi")).pagination.total, 0);
+});
+
+test("search has ten-item stable pages and bounded marked excerpts", async t => {
+    const root = await fixture(t);
+    await writeFile(join(root, "a.qll"), Array.from({ length: 25 }, (_, i) =>
+        `class Item${i} { // ${"x".repeat(250)}\n}`).join("\n"));
+    const first = await searchApi(root, "Item");
+    const second = await searchApi(root, "Item", 10);
+    assert.equal(first.items.length, 10);
+    assert.equal(first.pagination.total, 25);
+    assert.equal(second.items[0].line, 21);
+    assert.deepEqual(second, await searchApi(root, "Item", 10));
+    assert.ok(first.items[0].source.length <= 2000);
+    assert.ok(first.items[0].source.split("\n").length <= 20);
+    assert.equal(first.items[0].truncated.characters, true);
+    assert.equal(second.items[0].truncated.before, true);
+    assert.equal(first.items[0].truncated.after, true);
+    assert.equal((await searchApi(root, "Item", 30)).pagination.hasMore, false);
+});
+
+test("boolean connective followed by a call is not a declaration", async t => {
+    const root = await fixture(t);
+    await writeFile(join(root, "a.qll"), "  or target()\n  and target()\n  not target()\n");
+    await writeFile(join(root, "z.qll"), "predicate target() { any() }\n");
+    const result = await searchApi(root, "target");
+    assert.equal(result.items[0].path, "z.qll");
+    assert.ok(result.items.slice(1).every(x => x.match_kind === "identifier"));
+});
+
+test("search does not follow file/directory symlinks or read other file types", async t => {
+    const root = await fixture(t);
+    const pack = join(root, "pack");
+    await mkdir(pack);
+    await writeFile(join(root, "outside.qll"), "class SecretExpr {}\n");
+    await writeFile(join(pack, "safe.qll"), "class SafeExpr {}\n");
+    await writeFile(join(pack, "ignored.txt"), "class SecretExpr {}\n");
+    await symlink(join(root, "outside.qll"), join(pack, "escape.qll"));
+    await symlink(root, join(pack, "escape-directory"));
+    assert.equal((await searchApi(pack, "SecretExpr")).items.length, 0);
+    assert.deepEqual((await searchApi(pack, "Expr")).items.map(x => x.name), ["SafeExpr"]);
+});
+
+test("missing or empty dependency is an error rather than an empty match", async t => {
+    const root = await fixture(t);
+    await assert.rejects(searchApi(undefined, "Expr"), /ROOT/);
+    await assert.rejects(searchApi(join(root, "missing"), "Expr"), /ENOENT/);
+    await assert.rejects(searchApi(root, "Expr"), /unavailable/);
+});
diff --git a/tests/diagnostics.test.mjs b/tests/diagnostics.test.mjs
new file mode 100644
index 0000000..df067da
--- /dev/null
+++ b/tests/diagnostics.test.mjs
@@ -0,0 +1,68 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { CodeQLLanguageServer } from "../dist/codeql-lsp-client.js";
+
+const uri = "file:///candidate/query.ql";
+const error = {
+    range: { start: { line: 0, character: 0 }, end: { line: 0, character: 1 } },
+    severity: 1,
+    message: "Unknown type",
+};
+
+function client() {
+    const instance = new CodeQLLanguageServer({ codeqlPath: "codeql" });
+    instance.connection = {};
+    return instance;
+}
+
+test("an early empty notification is cached", async () => {
+    const instance = client();
+    instance.handleDiagnostics({ uri, diagnostics: [] });
+    assert.deepEqual(await instance.getDiagnostics(uri, 50), []);
+    assert.deepEqual(await instance.getDiagnostics(uri, 50), []);
+});
+
+test("an empty notification resolves all pending readers", async () => {
+    const instance = client();
+    const first = instance.getDiagnostics(uri, 50);
+    const second = instance.getDiagnostics(uri, 50);
+    instance.handleDiagnostics({ uri, diagnostics: [] });
+    assert.deepEqual(await first, []);
+    assert.deepEqual(await second, []);
+    assert.equal(instance.diagnosticsListeners.size, 0);
+});
+
+test("errors and URI isolation are preserved", async () => {
+    const instance = client();
+    instance.handleDiagnostics({ uri, diagnostics: [error] });
+    assert.deepEqual(await instance.getDiagnostics(uri, 50), [error]);
+    await assert.rejects(instance.getDiagnostics("file:///another/query.ql", 10), /Timeout/);
+    assert.equal(instance.diagnosticsListeners.size, 0);
+});
+
+test("no notification is a timeout, not an empty success", async () => {
+    const instance = client();
+    await assert.rejects(instance.getDiagnostics(uri, 10), /Timeout/);
+    assert.equal(instance.diagnosticsCache.has(uri), false);
+});
+
+test("a new session cannot reuse another candidate's diagnostics", async () => {
+    const first = client();
+    first.handleDiagnostics({ uri, diagnostics: [error] });
+    const second = client();
+    assert.equal(second.diagnosticsCache.has(uri), false);
+    second.handleDiagnostics({ uri, diagnostics: [] });
+    assert.deepEqual(await second.getDiagnostics(uri, 50), []);
+});
+
+test("LSP requests have a bounded timeout", async () => {
+    const instance = client();
+    instance.connection.sendRequest = () => new Promise(() => {});
+    await assert.rejects(instance.request("textDocument/hover", {}, 10), /timed out/);
+});
+
+test("hover transport errors are not hidden as missing hover", async () => {
+    const instance = client();
+    instance.connection.sendRequest = async () => { throw new Error("transport closed"); };
+    await assert.rejects(instance.getHover(uri, 0, 0), /transport closed/);
+});
