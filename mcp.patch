diff --git a/tests/diagnostics.test.mjs b/tests/diagnostics.test.mjs
new file mode 100644
index 0000000..df067da
--- /dev/null
+++ b/tests/diagnostics.test.mjs
@@ -0,0 +1,68 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { CodeQLLanguageServer } from "../dist/codeql-lsp-client.js";
+
+const uri = "file:///candidate/query.ql";
+const error = {
+    range: { start: { line: 0, character: 0 }, end: { line: 0, character: 1 } },
+    severity: 1,
+    message: "Unknown type",
+};
+
+function client() {
+    const instance = new CodeQLLanguageServer({ codeqlPath: "codeql" });
+    instance.connection = {};
+    return instance;
+}
+
+test("an early empty notification is cached", async () => {
+    const instance = client();
+    instance.handleDiagnostics({ uri, diagnostics: [] });
+    assert.deepEqual(await instance.getDiagnostics(uri, 50), []);
+    assert.deepEqual(await instance.getDiagnostics(uri, 50), []);
+});
+
+test("an empty notification resolves all pending readers", async () => {
+    const instance = client();
+    const first = instance.getDiagnostics(uri, 50);
+    const second = instance.getDiagnostics(uri, 50);
+    instance.handleDiagnostics({ uri, diagnostics: [] });
+    assert.deepEqual(await first, []);
+    assert.deepEqual(await second, []);
+    assert.equal(instance.diagnosticsListeners.size, 0);
+});
+
+test("errors and URI isolation are preserved", async () => {
+    const instance = client();
+    instance.handleDiagnostics({ uri, diagnostics: [error] });
+    assert.deepEqual(await instance.getDiagnostics(uri, 50), [error]);
+    await assert.rejects(instance.getDiagnostics("file:///another/query.ql", 10), /Timeout/);
+    assert.equal(instance.diagnosticsListeners.size, 0);
+});
+
+test("no notification is a timeout, not an empty success", async () => {
+    const instance = client();
+    await assert.rejects(instance.getDiagnostics(uri, 10), /Timeout/);
+    assert.equal(instance.diagnosticsCache.has(uri), false);
+});
+
+test("a new session cannot reuse another candidate's diagnostics", async () => {
+    const first = client();
+    first.handleDiagnostics({ uri, diagnostics: [error] });
+    const second = client();
+    assert.equal(second.diagnosticsCache.has(uri), false);
+    second.handleDiagnostics({ uri, diagnostics: [] });
+    assert.deepEqual(await second.getDiagnostics(uri, 50), []);
+});
+
+test("LSP requests have a bounded timeout", async () => {
+    const instance = client();
+    instance.connection.sendRequest = () => new Promise(() => {});
+    await assert.rejects(instance.request("textDocument/hover", {}, 10), /timed out/);
+});
+
+test("hover transport errors are not hidden as missing hover", async () => {
+    const instance = client();
+    instance.connection.sendRequest = async () => { throw new Error("transport closed"); };
+    await assert.rejects(instance.getHover(uri, 0, 0), /transport closed/);
+});
